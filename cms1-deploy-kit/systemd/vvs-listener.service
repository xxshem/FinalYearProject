[Unit]
Description=VVS Gate Listener (LoRa CH1, CMS1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@VVS_USER@
ExecStartPre=/bin/sleep 5
WorkingDirectory=@VVS_HOME@/vvs/lora
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-@VVS_HOME@/vvs.env
ExecStart=@VVS_HOME@/vvs-venv/bin/python3 @VVS_HOME@/vvs/lora/gate_listener.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target