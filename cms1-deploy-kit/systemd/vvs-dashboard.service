[Unit]
Description=VVS Dashboard (Flask, CMS1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@VVS_USER@
WorkingDirectory=@VVS_HOME@/vvs/dashboard
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-@VVS_HOME@/vvs.env
ExecStart=@VVS_HOME@/vvs-venv/bin/python3 @VVS_HOME@/vvs/dashboard/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target