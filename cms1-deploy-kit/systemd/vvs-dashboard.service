[Unit]
Description=VVS Dashboard (Flask, CMS1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/vvs/dashboard
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/pi/vvs.env
ExecStart=/home/pi/vvs-venv/bin/python3 /home/pi/vvs/dashboard/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target